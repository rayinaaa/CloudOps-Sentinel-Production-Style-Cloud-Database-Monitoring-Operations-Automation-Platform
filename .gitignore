# ==============================================================================
# CloudOps Sentinel - Git Ignore Specification
# ==============================================================================

# Environment files and credentials (CRITICAL: Never commit secrets)
.env
.env.*
!.env.example
!*.example
*.pem
*.key
*.crt
*.pfx
secrets/
credentials/
aws_credentials

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing, Coverage & Quality Tools
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
.ruff_cache/
.mypy_cache/

# Databases, Storage & Backup artifacts
*.sqlite3
*.db
*.dump
*.sql.gz
postgres_data/
target_postgres_data/
prometheus_data/
grafana_data/
backups/

# Logs & Runtime telemetry
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node / Frontend artifacts
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.next/
frontend/out/

# IDE & OS files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
Desktop.ini
*$*

# Docker local overrides
docker-compose.override.yml

