# ==============================================================================
# CloudOps Sentinel - AWS Production Environment Variable Template
# NOTE: In production, values are dynamically retrieved from AWS Secrets Manager
# or AWS Systems Manager (SSM) Parameter Store via IAM Instance Profile.
# NEVER commit populated credentials to version control.
# ==============================================================================

# 1. Application Runtime
ENVIRONMENT=production
APP_NAME=CloudOps Sentinel
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
SECRET_KEY=SECURE_GENERATED_32_CHAR_RANDOM_SECRET_KEY
CORS_ORIGINS=["https://sentinel.yourdomain.com", "http://YOUR_ALB_OR_EC2_PUBLIC_DNS"]

# 2. Amazon RDS PostgreSQL 16 Metadata Database
POSTGRES_SERVER=cloudops-sentinel-db.c12345678901.us-east-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=sentinel_db
POSTGRES_USER=sentinel_admin
POSTGRES_PASSWORD=SECURE_RDS_GENERATED_PASSWORD

# Asynchronous connection string with TLS/SSL enforcement
DATABASE_URL=postgresql+asyncpg://sentinel_admin:SECURE_RDS_GENERATED_PASSWORD@cloudops-sentinel-db.c12345678901.us-east-1.rds.amazonaws.com:5432/sentinel_db?ssl=require
SYNC_DATABASE_URL=postgresql://sentinel_admin:SECURE_RDS_GENERATED_PASSWORD@cloudops-sentinel-db.c12345678901.us-east-1.rds.amazonaws.com:5432/sentinel_db?sslmode=require

# Database Connection Pool (Sized for single-AZ / multi-AZ RDS)
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=25
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# 3. Monitored Target Database Defaults (AWS RDS Target)
TARGET_POSTGRES_SERVER=cloudops-sentinel-db.c12345678901.us-east-1.rds.amazonaws.com
TARGET_POSTGRES_PORT=5432
TARGET_POSTGRES_DB=sentinel_db
TARGET_POSTGRES_USER=monitor_agent
TARGET_POSTGRES_PASSWORD=SECURE_MONITOR_AGENT_PASSWORD
TARGET_DATABASE_URL=postgresql+asyncpg://monitor_agent:SECURE_MONITOR_AGENT_PASSWORD@cloudops-sentinel-db.c12345678901.us-east-1.rds.amazonaws.com:5432/sentinel_db?ssl=require

# 4. Telemetry & Alerting Thresholds
PROMETHEUS_METRICS_ENABLED=true
METRICS_SCRAPE_INTERVAL_SECONDS=15
SLOW_QUERY_THRESHOLD_MS=500
CONNECTION_POOL_WARNING_THRESHOLD=0.80
CONNECTION_POOL_CRITICAL_THRESHOLD=0.90
CACHE_HIT_RATIO_MIN_THRESHOLD=0.90

# 5. AWS Cloud Integration (Uses IAM Instance Profile - no explicit keys)
AWS_REGION=us-east-1
S3_BACKUP_BUCKET=cloudops-sentinel-backups-ACCOUNT_ID-us-east-1
S3_BACKUP_PREFIX=db-snapshots/
S3_STORAGE_CLASS=STANDARD_IA
CLOUDWATCH_METRICS_ENABLED=true
CLOUDWATCH_NAMESPACE=CloudOpsSentinel/Databases

# 6. Incident Management Integrations
ALERT_WEBHOOK_URL=http://localhost:8000/api/v1/incidents/alerts/webhook
PAGERDUTY_ROUTING_KEY=

# 7. Grafana Security
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=SECURE_GRAFANA_ADMIN_PASSWORD

