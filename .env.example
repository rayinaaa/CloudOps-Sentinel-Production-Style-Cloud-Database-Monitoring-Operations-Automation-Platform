# ==============================================================================
# CloudOps Sentinel - Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH YOUR LOCAL OR PRODUCTION SECRETS.
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
ENVIRONMENT=development               # Options: development, staging, production
APP_NAME="CloudOps Sentinel"
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO                         # DEBUG, INFO, WARNING, ERROR, CRITICAL
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ------------------------------------------------------------------------------
# 2. SENTINEL METADATA DATABASE (Stores targets, snapshots, audit logs, alerts)
# ------------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5434
POSTGRES_DB=sentinel_db
POSTGRES_USER=sentinel_admin
POSTGRES_PASSWORD=CHANGE_ME_SENTINEL_SECURE_PASSWORD
# Async SQLAlchemy connection URL (asyncpg)
DATABASE_URL=postgresql+asyncpg://sentinel_admin:CHANGE_ME_SENTINEL_SECURE_PASSWORD@localhost:5434/sentinel_db
# Sync SQLAlchemy URL for Alembic migrations
SYNC_DATABASE_URL=postgresql://sentinel_admin:CHANGE_ME_SENTINEL_SECURE_PASSWORD@localhost:5434/sentinel_db

# Connection Pool Tuning (Cloud Ops Best Practice)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800                   # Recycle connections after 30 mins to avoid stale sockets

# ------------------------------------------------------------------------------
# 3. SAMPLE MONITORED TARGET DATABASE (Simulated RDS / EC2 PostgreSQL)
# ------------------------------------------------------------------------------
TARGET_POSTGRES_SERVER=localhost
TARGET_POSTGRES_PORT=5433
TARGET_POSTGRES_DB=ecommerce_production
TARGET_POSTGRES_USER=monitor_agent
TARGET_POSTGRES_PASSWORD=CHANGE_ME_TARGET_SECURE_PASSWORD
TARGET_DATABASE_URL=postgresql+asyncpg://monitor_agent:CHANGE_ME_TARGET_SECURE_PASSWORD@localhost:5433/ecommerce_production

# ------------------------------------------------------------------------------
# 4. TELEMETRY, PROMETHEUS & OBSERVABILITY
# ------------------------------------------------------------------------------
PROMETHEUS_METRICS_ENABLED=true
METRICS_SCRAPE_INTERVAL_SECONDS=15
SLOW_QUERY_THRESHOLD_MS=500            # Alert queries taking longer than 500ms
CONNECTION_POOL_WARNING_THRESHOLD=0.80 # 80% saturation triggers WARNING
CONNECTION_POOL_CRITICAL_THRESHOLD=0.95 # 95% saturation triggers CRITICAL
CACHE_HIT_RATIO_MIN_THRESHOLD=0.90     # Alert if buffer cache hit ratio drops below 90%

# ------------------------------------------------------------------------------
# 5. AWS CLOUD INTEGRATION (S3 Backups & CloudWatch Telemetry)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGE_ME_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET_ACCESS_KEY
S3_BACKUP_BUCKET=cloudops-sentinel-backups-dev
S3_BACKUP_PREFIX=db-snapshots/
S3_STORAGE_CLASS=STANDARD_IA           # STANDARD, STANDARD_IA, GLACIER
CLOUDWATCH_METRICS_ENABLED=false
CLOUDWATCH_NAMESPACE=CloudOpsSentinel/Databases

# ------------------------------------------------------------------------------
# 6. INCIDENT MANAGEMENT & NOTIFICATIONS (Ops Runbook Integrations)
# ------------------------------------------------------------------------------
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE/ME/WEBHOOK
PAGERDUTY_ROUTING_KEY=CHANGE_ME_IF_USING_PAGERDUTY

# ------------------------------------------------------------------------------
# 7. AUTOMATED OPERATIONS & MAINTENANCE RUNNER
# ------------------------------------------------------------------------------
BACKUP_RETENTION_DAYS=7
BACKUP_COMPRESSION_LEVEL=6             # gzip compression level 1-9
AUTO_VACUUM_ANALYZE_ENABLED=true
AUTO_VACUUM_CRON="0 2 * * *"           # Run nightly at 02:00 UTC

